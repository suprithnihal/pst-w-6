import java.io.*;
import java.util.*;

public class Solution {

    // Sparse Table for Range Maximum Query
    static class SparseTable {
        int[][] table;
        int[] log;

        SparseTable(int[] arr) {
            int n = arr.length;

            log = new int[n + 1];
            for (int i = 2; i <= n; i++) {
                log[i] = log[i / 2] + 1;
            }

            int levels = log[n] + 1;
            table = new int[levels][n];

            System.arraycopy(arr, 0, table[0], 0, n);

            for (int k = 1; k < levels; k++) {
                int len = 1 << k;
                int half = len >> 1;

                for (int i = 0; i + len <= n; i++) {
                    table[k][i] = Math.max(
                        table[k - 1][i],
                        table[k - 1][i + half]
                    );
                }
            }
        }

        int query(int left, int right) {
            if (left > right) {
                return 0;
            }

            int len = right - left + 1;
            int k = log[len];

            return Math.max(
                table[k][left],
                table[k][right - (1 << k) + 1]
            );
        }
    }

    // Manacher's algorithm on:
    // #a#b#c#
    //
    // radius[i] = number of transformed characters
    // matching around center i.
    static int[] manacher(String s) {
        int n = s.length();

        char[] transformed = new char[2 * n + 1];

        for (int i = 0; i < transformed.length; i++) {
            if ((i & 1) == 0) {
                transformed[i] = '#';
            } else {
                transformed[i] = s.charAt(i / 2);
            }
        }

        int m = transformed.length;
        int[] radius = new int[m];

        int center = 0;
        int right = 0;

        for (int i = 0; i < m; i++) {

            int mirror = 2 * center - i;

            if (i < right) {
                radius[i] = Math.min(right - i, radius[mirror]);
            }

            while (i - radius[i] - 1 >= 0 &&
                   i + radius[i] + 1 < m &&
                   transformed[i - radius[i] - 1]
                       == transformed[i + radius[i] + 1]) {
                radius[i]++;
            }

            if (i + radius[i] > right) {
                center = i;
                right = i + radius[i];
            }
        }

        return radius;
    }

    public static List<Integer> circularPalindromes(String s) {

        int n = s.length();

        // Duplicate the string.
        String doubled = s + s;

        // Run Manacher once.
        int[] radius = manacher(doubled);

        // RMQ over Manacher radii.
        SparseTable st = new SparseTable(radius);

        List<Integer> answer = new ArrayList<>(n);

        for (int start = 0; start < n; start++) {

            /*
             * In the transformed string, the rotation
             * starts at:
             *
             * start * 2 + 1
             *
             * and contains n original characters.
             */
            int left = start * 2 + 1;
            int right = (start + n - 1) * 2 + 1;

            int low = 1;
            int high = n;
            int best = 1;

            while (low <= high) {
                int len = (low + high) / 2;

                /*
                 * A palindrome of length len must have its
                 * center in this range.
                 */
                int centerLeft = left + len - 1;
                int centerRight = right - len + 1;

                if (centerLeft <= centerRight &&
                    st.query(centerLeft, centerRight) >= len) {

                    best = len;
                    low = len + 1;

                } else {
                    high = len - 1;
                }
            }

            answer.add(best);
        }

        return answer;
    }

    public static void main(String[] args) throws Exception {

        BufferedReader br =
            new BufferedReader(new InputStreamReader(System.in));

        int n = Integer.parseInt(br.readLine().trim());

        String s = br.readLine().trim();

        List<Integer> result = circularPalindromes(s);

        StringBuilder out = new StringBuilder();

        for (int x : result) {
            out.append(x).append('\n');
        }

        System.out.print(out);
    }
}
